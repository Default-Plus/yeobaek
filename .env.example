# Google OAuth 2.0 Client ID (Web Application — used for Web/PWA & Windows Desktop .exe)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Mobile Client IDs (Android / iOS native PKCE via Chrome Custom Tabs / Safari)
NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional custom redirect URI override for mobile PKCE (defaults to app.defaultplus.yeobaek:/oauth2redirect)
NEXT_PUBLIC_GOOGLE_MOBILE_REDIRECT_URI=
